{
 "cells": [
  {
   "kind": 2,
   "value": "(*Pendulum Equation from Lab 5*)\r\n\r\n(*Initialize Omega, l, g*)\r\nClearAll[\"Global`*\"]\r\nClearAll[t]\r\nl = 10\r\ng = 980\r\n\\[Omega]0 = Sqrt[(g/l)]\r\n\r\n\r\n(*Call NDSolve[]*)\r\nsol = NDSolve[\r\n  {a''[t] == -\\[Omega]0 ^ 2 Sin[a[t]],\r\n   a'[0] == 0,\r\n   a[0] == 90 Degree},\r\n  a, {t, 0, 2}]\r\n\r\nPlot[Evaluate[a[t] /. sol], {t, 0, 2},\r\n  AxesLabel -> {\"t (s)\", \"\\[Phi] (rad)\"},\r\n  PlotLabel -> \"Pendulum, \\[Phi]0 = 90\\[Degree]\"]\r\n\r\n(*Evaluate Function at a Specified Time*)\r\nsol[[1]][[1]][[2]][0.25]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
